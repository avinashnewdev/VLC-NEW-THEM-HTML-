{
  "name": "vlc-new-theme-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Electron desktop shell for VLC New Theme HTML Player with native libVLC playback",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:mac": "electron-builder --mac dmg"
  },
  "dependencies": {
    "koffi": "^2.14.1"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.avinash.vlcnewtheme",
    "productName": "VLC New Theme Player",
    "directories": { "output": "dist" },
    "files": ["**/*", "!dist/**", "!node_modules/.cache/**"],
    "extraResources": [
      { "from": "vendor/libvlc", "to": "libvlc", "filter": ["**/*"] }
    ],
    "win": { "target": ["nsis"], "artifactName": "${productName}-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}